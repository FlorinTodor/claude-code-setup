{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push *)"
    ]
  },
  "autoMemoryEnabled": true
}
